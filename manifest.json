{
  "id": "riganything",
  "name": "RigAnything",
  "type": "model",
  "source": "https://github.com/iammojogo-sudo/Mesh_Rigging_Modly",
  "description": "Auto-rig any 3D mesh (human, quad, multi, etc.) using RigAnything template-free autoregressive rigging.",
  "version": "1.0.0",
  "author": "iammojogo",
  "vram_gb": 4,
  "tags": [
    "auto-rig",
    "rigging",
    "skeleton"
  ],
  "nodes": [
    {
      "id": "rig",
      "name": "Rig Mesh",
      "input": "mesh",
      "inputs": ["mesh"],
      "output": "mesh",
      "hf_repo": "Isabellaliu/RigAnything",
      "download_check": "riganything_ckpt.pt",
      "hf_skip_prefixes": [],
      "params_schema": [
        {
          "id": "simplify_mesh",
          "label": "Simplify Mesh",
          "type": "select",
          "default": "1",
          "options": [
            { "value": "1", "label": "Yes" },
            { "value": "0", "label": "No" }
          ],
          "tooltip": "Simplify the mesh before rigging for better performance."
        },
        {
          "id": "target_face_count",
          "label": "Target Face Count",
          "type": "int",
          "default": 8192,
          "min": 1000,
          "max": 50000,
          "tooltip": "Target number of faces after simplification (only used when Simplify Mesh is Yes)."
        }
      ]
    }
  ],
  "generator_class": "RigAnythingGenerator"
}
